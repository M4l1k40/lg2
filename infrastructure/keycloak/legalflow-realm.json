{
  "realm": "legalflow",
  "displayName": "LegalFlow",
  "displayNameHtml": "<b>LegalFlow</b>",
  "enabled": true,
  "accessTokenLifespan": 1800,
  "sslRequired": "external",
  "loginTheme": "keycloak",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultLocale": "en",
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Platform administrator" },
      { "name": "LAWYER", "description": "Law firm lawyer" },
      { "name": "SECRETARY", "description": "Law firm secretary" },
      { "name": "CLIENT", "description": "Client user" }
    ]
  },
  "clients": [
    {
      "clientId": "legalflow-frontend",
      "name": "LegalFlow Frontend",
      "description": "React SPA client",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "lawFirmId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lawFirmId",
            "jsonType.label": "String",
            "aggregate.attrs": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "claim.name": "lawFirmId"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "basic"]
    },
    {
      "clientId": "legalflow-gateway",
      "name": "LegalFlow Gateway",
      "description": "Gateway service validating JWTs",
      "secret": "legalflow-gateway-secret",
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false,
      "redirectUris": [
        "http://localhost:9000/*"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@dev-only.legalflow.local",
      "firstName": "DEV ONLY Platform",
      "lastName": "Administrator",
      "emailVerified": true,
      "attributes": {
        "lawFirmId": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "lawyer-a",
      "enabled": true,
      "email": "lawyer-a@dev-only.legalflow.local",
      "firstName": "DEV ONLY Lawyer",
      "lastName": "A",
      "emailVerified": true,
      "attributes": {
        "lawFirmId": ["11111111-1111-1111-1111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "lawyer-a",
          "temporary": false
        }
      ],
      "realmRoles": ["LAWYER"]
    },
    {
      "username": "lawyer-b",
      "enabled": true,
      "email": "lawyer-b@dev-only.legalflow.local",
      "firstName": "DEV ONLY Lawyer",
      "lastName": "B",
      "emailVerified": true,
      "attributes": {
        "lawFirmId": ["44444444-4444-4444-4444-444444444444"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "lawyer-b",
          "temporary": false
        }
      ],
      "realmRoles": ["LAWYER"]
    }
  ],
  "requiredActions": [],
