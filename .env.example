# Shared infrastructure configuration
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_GATEWAY_CLIENT_SECRET=replace-with-secure-secret

# PostgreSQL defaults
POSTGRES_DB=legalflow
POSTGRES_USER=legalflow
POSTGRES_PASSWORD=change-me

# Gateway configuration
GATEWAY_PORT=8080
JWT_ISSUER_URI=http://keycloak:8080/realms/legalflow
JWT_JWK_SET_URI=http://keycloak:8080/realms/legalflow/protocol/openid-connect/certs

# MinIO configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Notification delivery (use a Gmail App Password; never commit real values)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=no-reply@legalflow.local

# WhatsApp Cloud API; MOCK avoids all external calls during local development
WHATSAPP_MODE=MOCK
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id

# RabbitMQ configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=legalflow
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password

# Frontend configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=legalflow
VITE_KEYCLOAK_CLIENT_ID=legalflow-frontend
